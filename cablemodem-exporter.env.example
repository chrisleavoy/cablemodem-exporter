# /etc/cablemodem-exporter/env  (owner root, mode 0600)
# Plain KEY=value per line: no quotes, backslashes or `export`. Read by the
# exporter's systemd unit and by cablemodem-reboot, which must agree on every
# value; a password that needs quotes goes in a file named by CM_PASSWORD_FILE.

# Required: the modem web UI password (often printed on the modem's label).
CM_PASSWORD=change-me

# Optional overrides (defaults shown).
#CM_HOST=192.168.100.1
#CM_USERNAME=cusadmin
#CM_TIMEOUT=10
#CM_POLL_INTERVAL=30
#CM_LISTEN_ADDRESS=127.0.0.1
#CM_LISTEN_PORT=9884
#CM_EVENT_TIMEZONE=UTC
#CM_EXPORT_EVENT_MESSAGES=false
